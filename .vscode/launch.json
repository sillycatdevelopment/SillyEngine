{
    // Run and Debug panel (⇧⌘D), then F5. Uses CodeLLDB.
    // "Run program" starts whichever program is selected in CMake Tools'
    // status bar ("Launch target"), so it works for any src/<part>/main.cpp.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run program (CMake launch target)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "terminal": "integrated"
        },
        {
            "name": "Tests: all",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build"
        }
    ]
}
